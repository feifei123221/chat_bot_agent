# Copy this file to .streamlit/secrets.toml and replace every placeholder.
# Never commit secrets.toml.
# Authing: create an OIDC application and copy its metadata URL here.
[auth]
redirect_uri = "http://localhost:8510/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-authing-client-id"
client_secret = "replace-with-authing-client-secret"
server_metadata_url = "replace-with-authing-oidc-metadata-url"
